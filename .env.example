# Lokale Entwicklung: passt zu docker-compose.yml
DATABASE_URL=mysql://resort:resort@localhost:3306/resort_members
# Mindestens 32 zufällige Zeichen, z. B.: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Nur hinter eigenem Reverse Proxy (Caddy/Hostinger) auf 1 setzen, sonst ist X-Forwarded-For fälschbar
TRUST_PROXY=0
